---
import Layout from "../../layouts/Layout.astro";
import PaperCard from "../../components/PaperCard.astro";
import { getCollection } from "astro:content";

const papers = (await getCollection("papers")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Papers" description="Publications and technical reports.">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-3xl font-bold" style="color: var(--ink);">Papers</h1>
    <p class="mt-2 max-w-xl" style="color: var(--ink-soft);">Publications, technical reports, and preprints.</p>

    {papers.length === 0 ? (
      <p class="mt-10 font-mono text-sm" style="color: var(--ink-faint);">
        No papers yet. Add Markdown files to src/content/papers/ — see CONTENT_GUIDE.md.
      </p>
    ) : (
      <div class="mt-10 flex flex-col gap-5">
        {papers.map((paper) => <PaperCard paper={paper} />)}
      </div>
    )}
  </section>
</Layout>
