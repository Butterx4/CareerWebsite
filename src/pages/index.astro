---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PaperCard from "../components/PaperCard.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);
const projectsToShow = featuredProjects.length > 0 ? featuredProjects : allProjects.slice(0, 3);

const allPapers = (await getCollection("papers")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const papersToShow = allPapers.slice(0, 2);
---

<Layout title="Home">
  <section class="mx-auto max-w-5xl px-6 pt-20 pb-16">
    <p class="font-mono text-sm" style="color: var(--accent);">{site.role}</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl" style="color: var(--ink);">
      {site.name}
    </h1>
    <p class="mt-5 max-w-xl text-lg" style="color: var(--ink-soft);">{site.tagline}</p>
    <div class="mt-8 flex flex-wrap gap-3 font-mono text-sm">
      <a
        href="/projects"
        class="rounded-md px-5 py-2.5 font-semibold text-white transition-opacity hover:opacity-90"
        style="background-color: var(--accent);"
      >
        View Projects
      </a>
      <a
        href="/papers"
        class="rounded-md border px-5 py-2.5 font-semibold transition-colors"
        style="border-color: var(--line); color: var(--ink);"
      >
        Read Papers
      </a>
      <a
        href={`mailto:${site.email}`}
        class="rounded-md border px-5 py-2.5 font-semibold transition-colors"
        style="border-color: var(--line); color: var(--ink);"
      >
        Contact
      </a>
    </div>
  </section>

  {projectsToShow.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 pb-16">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="font-mono text-sm font-semibold uppercase tracking-wider" style="color: var(--ink-faint);">
          Selected Projects
        </h2>
        <a href="/projects" class="font-mono text-sm hover:underline" style="color: var(--accent);">
          All projects &rarr;
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projectsToShow.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  {papersToShow.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 pb-24">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="font-mono text-sm font-semibold uppercase tracking-wider" style="color: var(--ink-faint);">
          Publications
        </h2>
        <a href="/papers" class="font-mono text-sm hover:underline" style="color: var(--accent);">
          All papers &rarr;
        </a>
      </div>
      <div class="flex flex-col gap-4">
        {papersToShow.map((paper) => <PaperCard paper={paper} />)}
      </div>
    </section>
  )}
</Layout>
