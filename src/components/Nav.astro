---
import { site } from "../site.config";

const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/papers", label: "Papers" },
  { href: "/about", label: "About" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b backdrop-blur" style="border-color: var(--line); background-color: color-mix(in srgb, var(--bg) 85%, transparent);">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 py-3 sm:px-6 sm:py-4">
    <a href="/" class="font-mono text-sm font-semibold tracking-tight" style="color: var(--ink);">
      {site.name}<span style="color: var(--accent);">.</span>
    </a>
    <div class="flex flex-wrap items-center gap-0.5 font-mono text-xs sm:gap-1 sm:text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded px-2 py-1.5 transition-colors sm:px-3"
          style={`color: ${isActive(link.href) ? "var(--accent)" : "var(--ink-soft)"};`}
        >
          {link.label}
        </a>
      ))}
      <a
        href={site.resumeHref}
        class="ml-1 rounded-md px-2.5 py-1.5 font-semibold whitespace-nowrap transition-opacity hover:opacity-90 sm:ml-2 sm:px-3"
        style="background-color: var(--accent); color: white;"
      >
        Resume
      </a>
    </div>
  </nav>
</header>
