---
// Interactive 3D viewer for CAD parts/assemblies exported to glTF/GLB.
// See CONTENT_GUIDE.md for how to export a SolidWorks part/assembly to .glb.
interface Props {
  src: string; // e.g. "/models/gripper.glb"
  poster?: string;
  alt?: string;
}

const { src, poster, alt = "3D model" } = Astro.props;
---

<model-viewer
  src={src}
  poster={poster}
  alt={alt}
  camera-controls
  touch-action="pan-y"
  auto-rotate
  auto-rotate-delay="1500"
  shadow-intensity="1"
  exposure="1"
  environment-image="neutral"
  style="width: 100%; height: 480px; border-radius: 0.5rem; background-color: var(--bg-alt); --poster-color: transparent;"
>
  <div slot="progress-bar"></div>
  <button
    slot="ar-button"
    style="display:none"
  ></button>
</model-viewer>

<script>
  import "@google/model-viewer";
</script>
