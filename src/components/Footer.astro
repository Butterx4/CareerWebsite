---
import { site } from "../site.config";

const year = new Date().getFullYear();
const socials = [
  { key: "github", label: "GitHub", href: site.social.github },
  { key: "linkedin", label: "LinkedIn", href: site.social.linkedin },
  { key: "googleScholar", label: "Google Scholar", href: site.social.googleScholar },
].filter((s) => s.href);
---

<footer class="border-t" style="border-color: var(--line);">
  <div class="mx-auto max-w-5xl px-6 py-10 font-mono text-sm" style="color: var(--ink-faint);">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p>&copy; {year} {site.name}</p>
      <div class="flex flex-wrap gap-5">
        <a href={`mailto:${site.email}`} class="hover:underline" style="color: var(--ink-soft);">
          {site.email}
        </a>
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer" class="hover:underline" style="color: var(--ink-soft);">
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
